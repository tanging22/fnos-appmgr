#!/bin/bash
# config_callback — 套件「设置」页保存后
#
# 设置是管理器自己写的，fnOS 这一层没有字段要落盘。
# 留这个脚本只是让套件设置入口的生命周期完整。
set -u

APP_NAME="${TRIM_APPNAME:-fnos-appmgr}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
DATA_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"

mkdir -p "${DATA_DIR}" 2>/dev/null || true
echo "[$(date '+%F %T')] config_callback (no fnOS-level settings; manager owns its own)" \
    >> "${DATA_DIR}/config.log" 2>/dev/null || true
exit 0
